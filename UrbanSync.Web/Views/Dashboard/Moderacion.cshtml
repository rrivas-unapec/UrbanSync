@model ModeracionViewModel
@{
    Layout = "_AdminLayout";
    var pendientes = Model.Cola.Count;
}
<div class="mb-4">
    <h1 class="fw-bold mb-1">Cola de Moderación</h1>
    @if (Model.DatosDisponibles)
    {
        <p class="text-muted mb-0">@pendientes reporte@(pendientes == 1 ? "" : "s") pendiente@(pendientes == 1 ? "" : "s") de revisión</p>
    }
</div>

@if (TempData["ModeracionError"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

@if (!Model.DatosDisponibles)
{
    <div class="card border-0 shadow-sm rounded-4 admin-kpi-pending">
        <div class="card-body text-center py-5">
            <i class="bi bi-wifi-off fs-1 text-muted mb-3 d-block"></i>
            <h3 class="fw-bold fs-5 mb-1 text-muted">Sin datos disponibles</h3>
            <p class="text-muted mb-0">La API de UrbanSync no respondió. Recarga la página para reintentar.</p>
        </div>
    </div>
}
else if (pendientes == 0)
{
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body text-center py-5">
            <i class="bi bi-check-circle fs-1 mb-3 d-block" style="color:#00A676;"></i>
            <h3 class="fw-bold fs-5 mb-1">¡Cola vacía!</h3>
            <p class="text-muted mb-0">Todos los reportes han sido moderados.</p>
        </div>
    </div>
}
else
{
    <div class="d-flex flex-column gap-3">
        @foreach (var item in Model.Cola)
        {
            var estilo = PrioridadEstilo(item.Prioridad);
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <div class="d-flex align-items-start gap-3 flex-wrap">
                        <div class="admin-kpi-icon flex-shrink-0" style="background-color:@estilo.Bg; color:@estilo.Fg;">
                            <i class="bi bi-flag"></i>
                        </div>
                        <div class="flex-grow-1" style="min-width:14rem;">
                            <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                <span class="font-monospace small fw-bold" style="color:#0057B8;">@item.CodigoCaso</span>
                                <span class="badge rounded-pill" style="background-color:@estilo.Bg; color:@estilo.Fg;">@item.Prioridad</span>
                                <span class="text-muted small">@Relativo(item.FechaReporte)</span>
                            </div>
                            <p class="fw-bold mb-0">@item.TipoIncidencia — @item.Direccion</p>
                            <p class="text-muted small mb-0">Reportado por: @item.UsuarioReporta · @item.Jurisdiccion</p>
                        </div>
                        <div class="d-flex gap-2 flex-shrink-0">
                            <form asp-action="ModeracionAccion" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="hidden" name="accion" value="aprobar" />
                                <button type="submit" class="btn btn-sm" style="background-color:rgba(0,166,118,.15); color:#00A676;">
                                    <i class="bi bi-check-lg"></i> Aprobar
                                </button>
                            </form>
                            <form asp-action="ModeracionAccion" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="hidden" name="accion" value="rechazar" />
                                <button type="submit" class="btn btn-sm btn-light">
                                    <i class="bi bi-x-lg"></i> Rechazar
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@functions {
    (string Bg, string Fg) PrioridadEstilo(string prioridad) => prioridad switch
    {
        "Critica" => ("rgba(228,87,46,.12)", "#E4572E"),
        "Alta" => ("rgba(224,122,0,.12)", "#E07A00"),
        "Baja" => ("rgba(0,166,118,.12)", "#00A676"),
        _ => ("rgba(0,87,184,.12)", "#0057B8")
    };

    string Relativo(DateTime fecha)
    {
        var diff = DateTime.Now - fecha;
        if (diff.TotalMinutes < 1) return "justo ahora";
        if (diff.TotalMinutes < 60) return $"hace {(int)diff.TotalMinutes}min";
        if (diff.TotalHours < 24) return $"hace {(int)diff.TotalHours}h";
        return $"hace {(int)diff.TotalDays}d";
    }
}

@model IncidentDetailsViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Detalle de incidencia";

    var incident = Model.Incident;

    var canManage =
        User.IsInRole("Administrador") ||
        User.IsInRole("SupervisorOperaciones") ||
        User.IsInRole("AnalistaTecnico");

    var canViewAudit =
        User.IsInRole("Administrador") ||
        User.IsInRole("SupervisorOperaciones");
}

<div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4">

    <div>

        <a
            asp-action="Index"
            class="text-decoration-none small">

            <i class="bi bi-arrow-left me-1"></i>
            Volver a incidencias
        </a>

        <h1 class="fw-bold mt-2 mb-1">
            @incident.CodigoCaso
        </h1>

        <div class="d-flex gap-2 flex-wrap">

            <span class="badge text-bg-light border">
                @FormatStatus(incident.Estado)
            </span>

            <span class="badge text-bg-primary">
                @incident.Prioridad
            </span>

            <span class="badge text-bg-light border">
                @incident.TipoIncidencia
            </span>

        </div>

    </div>

</div>

@if (TempData["IncidentSuccess"] is string success)
{
    <div class="alert alert-success">
        @success
    </div>
}

@if (TempData["IncidentError"] is string error)
{
    <div class="alert alert-danger">
        @error
    </div>
}

<div class="row g-4">

    <div class="col-lg-8">

        <div class="card border-0 shadow-sm rounded-4 mb-4">

            <div class="card-body p-4">

                <h2 class="h5 fw-bold mb-3">
                    Información de la incidencia
                </h2>

                <p class="mb-4">
                    @incident.Descripcion
                </p>

                <div class="row g-3">

                    <div class="col-md-6">

                        <span class="text-muted small d-block">
                            Dirección
                        </span>

                        <strong>
                            @incident.Direccion
                        </strong>
                    </div>

                    <div class="col-md-6">

                        <span class="text-muted small d-block">
                            Referencia
                        </span>

                        <strong>
                            @(string.IsNullOrWhiteSpace(incident.Referencia)
                                ? "—"
                                : incident.Referencia)
                        </strong>

                    </div>

                    <div class="col-md-6">

                        <span class="text-muted small d-block">
                            Jurisdicción
                        </span>

                        <strong>
                            @incident.Jurisdiccion
                        </strong>

                    </div>

                    <div class="col-md-6">

                        <span class="text-muted small d-block">
                            Reportado por
                        </span>

                        <strong>
                            @incident.UsuarioReporta
                        </strong>

                    </div>

                    <div class="col-md-6">

                        <span class="text-muted small d-block">
                            Fecha de reporte
                        </span>

                        <strong>
                            @incident.FechaReporte.ToString(
                                "dd/MM/yyyy HH:mm")
                        </strong>

                    </div>

                    <div class="col-md-6">

                        <span class="text-muted small d-block">
                            Institución asignada
                        </span>

                        <strong>
                            @(string.IsNullOrWhiteSpace(
                                incident.InstitucionAsignada)
                                ? "Sin asignar"
                                : incident.InstitucionAsignada)
                        </strong>

                    </div>

                    @if (
                        incident.Latitud.HasValue &&
                        incident.Longitud.HasValue)
                    {
                        <div class="col-12">

                            <span class="text-muted small d-block">
                                Coordenadas
                            </span>

                            <strong>
                                @incident.Latitud.Value.ToString("0.000000"),
                                @incident.Longitud.Value.ToString("0.000000")
                            </strong>

                        </div>
                    }

                </div>

            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 mb-4">

            <div class="card-body p-4">

                <h2 class="h5 fw-bold mb-3">
                    Evidencias
                </h2>

                @if (!Model.EvidenciasDisponibles)
                {
                    <p class="text-muted small mb-0">
                        No se pudieron consultar las evidencias.
                    </p>
                }
                else
                {
                    @if (Model.Evidencias.Count == 0)
                    {
                        <p class="text-muted small mb-3">
                            No hay evidencias registradas para esta incidencia.
                        </p>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-3 mb-3">
                            @foreach (var evidencia in Model.Evidencias)
                            {
                                <div class="border rounded-3 p-3">
                                    <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                        <span class="badge text-bg-light border">
                                            @evidencia.EvidenceType
                                        </span>
                                        <span class="text-muted small">
                                            @evidencia.UploadedByUserName
                                            ·
                                            @evidencia.UploadedAt.ToString("dd/MM/yyyy HH:mm")
                                        </span>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(evidencia.Description))
                                    {
                                        <p class="mb-1">@evidencia.Description</p>
                                    }

                                    <a href="@evidencia.FilePath" target="_blank" rel="noopener" class="small">
                                        @evidencia.FilePath
                                    </a>
                                </div>
                            }
                        </div>
                    }

                    @if (canManage)
                    {
                        <form asp-action="UploadEvidence" method="post" class="border-top pt-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="incidentId" value="@incident.Id" />

                            <div class="row g-2">
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold">Tipo</label>
                                    <select name="evidenceType" class="form-select form-select-sm" required>
                                        <option value="Foto">Foto</option>
                                        <option value="Video">Video</option>
                                        <option value="Documento">Documento</option>
                                    </select>
                                </div>
                                <div class="col-md-8">
                                    <label class="form-label small fw-semibold">Ruta o URL del archivo</label>
                                    <input type="text" name="filePath" class="form-control form-control-sm" maxlength="400" required />
                                </div>
                                <div class="col-12">
                                    <label class="form-label small fw-semibold">Descripción (opcional)</label>
                                    <input type="text" name="description" class="form-control form-control-sm" maxlength="300" />
                                </div>
                                <div class="col-12">
                                    <button type="submit" class="btn btn-sm btn-dark">
                                        Agregar evidencia
                                    </button>
                                </div>
                            </div>
                        </form>
                    }
                }

            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 mb-4">

            <div class="card-body p-4">

                <h2 class="h5 fw-bold mb-3">
                    Análisis técnico
                </h2>

                @if (!Model.AnalisisTecnicoDisponible)
                {
                    <p class="text-muted small mb-0">
                        No se pudo consultar el análisis técnico.
                    </p>
                }
                else if (Model.AnalisisTecnico is not null)
                {
                    <p class="text-muted small mb-1">
                        @Model.AnalisisTecnico.TechnicalUserName
                        ·
                        @Model.AnalisisTecnico.AnalysisDate.ToString("dd/MM/yyyy HH:mm")
                    </p>

                    <p class="mb-2">
                        <strong>Diagnóstico:</strong>
                        @Model.AnalisisTecnico.Diagnosis
                    </p>

                    @if (!string.IsNullOrWhiteSpace(Model.AnalisisTecnico.RecommendedActions))
                    {
                        <p class="mb-0">
                            <strong>Acciones recomendadas:</strong>
                            @Model.AnalisisTecnico.RecommendedActions
                        </p>
                    }
                }
                else
                {
                    <p class="text-muted small mb-3">
                        Esta incidencia todavía no tiene un análisis técnico registrado.
                    </p>

                    @if (canManage)
                    {
                        <form asp-action="SaveTechnicalAnalysis" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="incidentId" value="@incident.Id" />

                            <div class="mb-2">
                                <label class="form-label small fw-semibold">Diagnóstico</label>
                                <textarea name="diagnosis" class="form-control form-control-sm" rows="3" maxlength="1000" required></textarea>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small fw-semibold">Acciones recomendadas (opcional)</label>
                                <textarea name="recommendedActions" class="form-control form-control-sm" rows="2" maxlength="1000"></textarea>
                            </div>

                            <button type="submit" class="btn btn-sm btn-dark">
                                Guardar análisis
                            </button>
                        </form>
                    }
                }

            </div>
        </div>

        @if (canViewAudit)
        {
            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4
                            d-flex justify-content-between
                            align-items-center gap-3 flex-wrap">

                    <div>

                        <h2 class="h5 fw-bold mb-1">
                            Auditoría
                        </h2>

                        <p class="text-muted mb-0">
                            Consulta los eventos registrados
                            sobre las incidencias.
                        </p>

                    </div>

                    <a
                        asp-controller="Activity"
                        asp-action="Index"
                        asp-route-entidad="Incidencias"
                        class="btn btn-outline-dark">

                        Ver auditoría
                    </a>

                </div>

            </div>
        }

    </div>

    <div class="col-lg-4">

        @if (canManage)
        {
            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4">

                    <h2 class="h5 fw-bold mb-3">
                        Actualizar estado
                    </h2>

                    <form
                        asp-action="UpdateStatus"
                        method="post">

                        @Html.AntiForgeryToken()

                        <input
                            type="hidden"
                            name="id"
                            value="@incident.Id" />

                        @if (incident.InstitucionAsignadaId.HasValue)
                        {
                            <input
                                type="hidden"
                                name="institucionAsignadaId"
                                value="@incident.InstitucionAsignadaId" />
                        }

                        <label
                            for="estado"
                            class="form-label fw-semibold">
                            Estado
                        </label>

                        <select
                            id="estado"
                            name="estado"
                            class="form-select mb-3"
                            required>

                            @foreach (
                                var status in new[]
                                {
                                    "Registrada",
                                    "EnAnalisis",
                                    "Asignada",
                                    "EnProceso",
                                    "Cerrada",
                                    "Rechazada"
                                })
                            {
                                if (string.Equals(
                                    incident.Estado,
                                    status,
                                    StringComparison.OrdinalIgnoreCase))
                                {
                                    <option
                                        value="@status"
                                        selected>
                                        @FormatStatus(status)
                                    </option>
                                }
                                else
                                {
                                    <option value="@status">
                                        @FormatStatus(status)
                                    </option>
                                }
                            }

                        </select>

                        <button
                            type="submit"
                            class="btn btn-primary w-100">

                            Guardar estado
                        </button>

                    </form>

                    @if (User.IsInRole("Administrador"))
                    {
                        <hr />

                        <a
                            asp-controller="Dashboard"
                            asp-action="Moderacion"
                            class="btn btn-outline-secondary w-100">

                            Ir a moderación / triage
                        </a>
                    }

                </div>

            </div>
        }

    </div>

</div>

@functions {

    string FormatStatus(string status) =>
        status switch
        {
            "EnAnalisis" => "En análisis",
            "EnProceso" => "En proceso",
            _ => status
        };
}
@model UrbanSync.Web.ApiClients.Incidents.IncidentResponse

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Detalle de incidencia";

    var canManage =
        User.IsInRole("Administrador") ||
        User.IsInRole("SupervisorOperaciones") ||
        User.IsInRole("AnalistaTecnico");

    var canViewAudit =
        User.IsInRole("Administrador") ||
        User.IsInRole("SupervisorOperaciones");
}

<div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4">

    <div>

        <a
            asp-action="Index"
            class="text-decoration-none small">

            <i class="bi bi-arrow-left me-1"></i>
            Volver a incidencias
        </a>

        <h1 class="fw-bold mt-2 mb-1">
            @Model.CodigoCaso
        </h1>

        <div class="d-flex gap-2 flex-wrap">

            <span class="badge text-bg-light border">
                @FormatStatus(Model.Estado)
            </span>

            <span class="badge text-bg-primary">
                @Model.Prioridad
            </span>

            <span class="badge text-bg-light border">
                @Model.TipoIncidencia
            </span>

        </div>

    </div>

</div>

@if (TempData["IncidentSuccess"] is string success)
{
    <div class="alert alert-success">
        @success
    </div>
}

@if (TempData["IncidentError"] is string error)
{
    <div class="alert alert-danger">
        @error
    </div>
}

<div class="row g-4">

    <div class="col-lg-8">

        <div class="card border-0 shadow-sm rounded-4 mb-4">

            <div class="card-body p-4">

                <h2 class="h5 fw-bold mb-3">
                    Información de la incidencia
                </h2>

                <p class="mb-4">
                    @Model.Descripcion
                </p>

                <div class="row g-3">

                    <div class="col-md-6">

                        <span class="text-muted small d-block">
                            Dirección
                        </span>

                        <strong>
                            @Model.Direccion
                        </strong>
                    </div>

                    <div class="col-md-6">

                        <span class="text-muted small d-block">
                            Referencia
                        </span>

                        <strong>
                            @(string.IsNullOrWhiteSpace(Model.Referencia)
                                ? "—"
                                : Model.Referencia)
                        </strong>

                    </div>

                    <div class="col-md-6">

                        <span class="text-muted small d-block">
                            Jurisdicción
                        </span>

                        <strong>
                            @Model.Jurisdiccion
                        </strong>

                    </div>

                    <div class="col-md-6">

                        <span class="text-muted small d-block">
                            Reportado por
                        </span>

                        <strong>
                            @Model.UsuarioReporta
                        </strong>

                    </div>

                    <div class="col-md-6">

                        <span class="text-muted small d-block">
                            Fecha de reporte
                        </span>

                        <strong>
                            @Model.FechaReporte.ToString(
                                "dd/MM/yyyy HH:mm")
                        </strong>

                    </div>

                    <div class="col-md-6">

                        <span class="text-muted small d-block">
                            Institución asignada
                        </span>

                        <strong>
                            @(string.IsNullOrWhiteSpace(
                                Model.InstitucionAsignada)
                                ? "Sin asignar"
                                : Model.InstitucionAsignada)
                        </strong>

                    </div>

                    @if (
                        Model.Latitud.HasValue &&
                        Model.Longitud.HasValue)
                    {
                        <div class="col-12">

                            <span class="text-muted small d-block">
                                Coordenadas
                            </span>

                            <strong>
                                @Model.Latitud.Value.ToString("0.000000"),
                                @Model.Longitud.Value.ToString("0.000000")
                            </strong>

                        </div>
                    }

                </div>

            </div>
        </div>

        @if (canViewAudit)
        {
            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4
                            d-flex justify-content-between
                            align-items-center gap-3 flex-wrap">

                    <div>

                        <h2 class="h5 fw-bold mb-1">
                            Auditoría
                        </h2>

                        <p class="text-muted mb-0">
                            Consulta los eventos registrados
                            sobre las incidencias.
                        </p>

                    </div>

                    <a
                        asp-controller="Activity"
                        asp-action="Index"
                        asp-route-entidad="Incidencias"
                        class="btn btn-outline-dark">

                        Ver auditoría
                    </a>

                </div>

            </div>
        }

    </div>

    <div class="col-lg-4">

        @if (canManage)
        {
            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4">

                    <h2 class="h5 fw-bold mb-3">
                        Actualizar estado
                    </h2>

                    <form
                        asp-action="UpdateStatus"
                        method="post">

                        @Html.AntiForgeryToken()

                        <input
                            type="hidden"
                            name="id"
                            value="@Model.Id" />

                        @if (Model.InstitucionAsignadaId.HasValue)
                        {
                            <input
                                type="hidden"
                                name="institucionAsignadaId"
                                value="@Model.InstitucionAsignadaId" />
                        }

                        <label
                            for="estado"
                            class="form-label fw-semibold">
                            Estado
                        </label>

                        <select
                            id="estado"
                            name="estado"
                            class="form-select mb-3"
                            required>

                            @foreach (
                                var status in new[]
                                {
                                    "Registrada",
                                    "EnAnalisis",
                                    "Asignada",
                                    "EnProceso",
                                    "Cerrada",
                                    "Rechazada"
                                })
                            {
                                if (string.Equals(
                                    Model.Estado,
                                    status,
                                    StringComparison.OrdinalIgnoreCase))
                                {
                                    <option
                                        value="@status"
                                        selected>
                                        @FormatStatus(status)
                                    </option>
                                }
                                else
                                {
                                    <option value="@status">
                                        @FormatStatus(status)
                                    </option>
                                }
                            }

                        </select>

                        <button
                            type="submit"
                            class="btn btn-primary w-100">

                            Guardar estado
                        </button>

                    </form>

                    @if (User.IsInRole("Administrador"))
                    {
                        <hr />

                        <a
                            asp-controller="Dashboard"
                            asp-action="Moderacion"
                            class="btn btn-outline-secondary w-100">

                            Ir a moderación / triage
                        </a>
                    }

                </div>

            </div>
        }

    </div>

</div>

@functions {

    string FormatStatus(string status) =>
        status switch
        {
            "EnAnalisis" => "En análisis",
            "EnProceso" => "En proceso",
            _ => status
        };
}
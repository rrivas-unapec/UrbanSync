@model IReadOnlyList<UrbanSync.Web.ApiClients.Incidents.IncidentResponse>

@{
    string? selectedStatus = ViewBag.Status;
    bool mineOnly = ViewBag.MineOnly ?? false;

    Layout = mineOnly ? "_Layout" : "_AdminLayout";
    ViewData["Title"] = "Incidencias";
}

<div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4">

    <div>
        <h1 class="fw-bold mb-1">
            @(mineOnly ? "Mis incidencias" : "Incidencias")
        </h1>

        <p class="text-muted mb-0">
            @(mineOnly
                ? "Consulta el estado y detalle de los reportes asociados a tu cuenta."
                : "Consulta y da seguimiento a las incidencias registradas en UrbanSync.")
        </p>
    </div>

    <div class="d-flex align-items-center gap-2">
        <span class="badge text-bg-light border px-3 py-2">
            @Model.Count registro@(Model.Count == 1 ? "" : "s")
        </span>

        @if (mineOnly)
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>
                Reportar incidencia
            </a>
        }
    </div>
</div>

@if (TempData["IncidentError"] is string tempError)
{
    <div class="alert alert-danger">
        @tempError
    </div>
}

@if (ViewBag.Error is string error)
{
    <div class="alert alert-danger">
        @error
    </div>
}

<form
    method="get"
    class="card border-0 shadow-sm rounded-4 mb-4">

    <div class="card-body">

        <div class="row g-3 align-items-end">

            <div class="col-md-5">

                <label
                    for="status"
                    class="form-label fw-semibold">
                    Estado
                </label>

                <select
                    id="status"
                    name="status"
                    class="form-select">

                    <option value="">
                        Todos los estados
                    </option>

                    @foreach (
                        var status in new[]
                        {
                            "Registrada",
                            "EnAnalisis",
                            "Asignada",
                            "EnProceso",
                            "Cerrada",
                            "Rechazada"
                        })
                    {
                        if (string.Equals(
                            selectedStatus,
                            status,
                            StringComparison.OrdinalIgnoreCase))
                        {
                            <option
                                value="@status"
                                selected>
                                @FormatStatus(status)
                            </option>
                        }
                        else
                        {
                            <option value="@status">
                                @FormatStatus(status)
                            </option>
                        }
                    }

                </select>
            </div>

            <div class="col-md-auto">

                <button
                    type="submit"
                    class="btn btn-primary">

                    <i class="bi bi-funnel me-1"></i>
                    Filtrar
                </button>

                <a
                    asp-action="Index"
                    class="btn btn-outline-secondary">
                    Limpiar
                </a>

            </div>

        </div>

    </div>
</form>

@if (Model.Count == 0)
{
    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body text-center py-5">

            <i class="bi bi-inbox fs-1 text-muted d-block mb-3"></i>

            <h2 class="h5 fw-bold">
                No hay incidencias para mostrar
            </h2>

            <p class="text-muted mb-0">
                Prueba otro filtro o vuelve más tarde.
            </p>

        </div>
    </div>
}
else
{
    <div class="row g-3">

        @foreach (var incident in Model)
        {
            <div class="col-12">

                <div class="card border-0 shadow-sm rounded-4">

                    <div class="card-body">

                        <div class="d-flex justify-content-between
                                    gap-3 flex-wrap">

                            <div class="flex-grow-1">

                                <div class="d-flex align-items-center
                                            gap-2 flex-wrap mb-2">

                                    <span class="font-monospace
                                                 fw-bold text-primary">
                                        @incident.CodigoCaso
                                    </span>

                                    <span class="badge rounded-pill
                                                 @PriorityClass(
                                                     incident.Prioridad)">
                                        @incident.Prioridad
                                    </span>

                                    <span class="badge rounded-pill
                                                 text-bg-light border">
                                        @FormatStatus(incident.Estado)
                                    </span>

                                </div>

                                <h2 class="h6 fw-bold mb-1">
                                    @incident.TipoIncidencia
                                </h2>

                                <p class="mb-2">
                                    @incident.Descripcion
                                </p>

                                <div class="small text-muted
                                            d-flex gap-3 flex-wrap">

                                    <span>
                                        <i class="bi bi-geo-alt me-1"></i>
                                        @incident.Direccion
                                    </span>

                                    <span>
                                        <i class="bi bi-building me-1"></i>
                                        @incident.Jurisdiccion
                                    </span>

                                    <span>
                                        <i class="bi bi-clock me-1"></i>
                                        @incident.FechaReporte.ToString(
                                            "dd/MM/yyyy HH:mm")
                                    </span>

                                </div>

                            </div>

                            <div class="align-self-center">

                                <a
                                    asp-action="Details"
                                    asp-route-id="@incident.Id"
                                    class="btn btn-outline-primary">

                                    Ver detalle
                                </a>

                            </div>

                        </div>

                    </div>
                </div>

            </div>
        }

    </div>
}

@functions {

    string FormatStatus(string status) =>
        status switch
        {
            "EnAnalisis" => "En análisis",
            "EnProceso" => "En proceso",
            _ => status
        };

    string PriorityClass(string priority)
    {
        var normalized =
            priority.Replace(
                "í",
                "i",
                StringComparison.OrdinalIgnoreCase);

        return normalized switch
        {
            "Critica" => "text-bg-danger",
            "Alta" => "text-bg-warning",
            "Baja" => "text-bg-success",
            _ => "text-bg-primary"
        };
    }
}
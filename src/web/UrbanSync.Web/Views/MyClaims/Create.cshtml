@model CreateClaimPageViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Crear reclamación";
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none small">
        <i class="bi bi-arrow-left me-1"></i>
        Volver a mis reclamaciones
    </a>

    <h1 class="fw-bold mt-2 mb-1">Crear reclamación</h1>
    <p class="text-muted mb-0">Cuéntanos qué necesitas reclamar.</p>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@error.ErrorMessage</div>
        }
    </div>
}

<div class="card border-0 shadow-sm rounded-4" style="max-width: 720px;">
    <div class="card-body p-4">

        @if (Model.Ubicaciones.Count == 0)
        {
            <p class="text-muted mb-0">
                Todavía no hay ubicaciones registradas en el sistema. Contacta a un administrador.
            </p>
        }
        else
        {
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label fw-semibold">Ubicación</label>
                    <select name="locationId" class="form-select" required>
                        <option value="">— Selecciona —</option>
                        @foreach (var ubicacion in Model.Ubicaciones)
                        {
                            <option value="@ubicacion.Id">@ubicacion.Address (@ubicacion.JurisdictionName)</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Categoría</label>
                    <input type="text" name="category" class="form-control" maxlength="50" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Título</label>
                    <input type="text" name="title" class="form-control" maxlength="150" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Descripción</label>
                    <textarea name="description" class="form-control" rows="4" maxlength="1000" required></textarea>
                </div>

                <button type="submit" class="btn btn-primary w-100">
                    Crear reclamación
                </button>
            </form>
        }

    </div>
</div>

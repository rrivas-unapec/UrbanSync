@model IReadOnlyList<UserListViewModel>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Gestión de usuarios</h2>

    <a asp-action="Create" class="btn btn-dark">
        Crear usuario
    </a>
</div>

@if (TempData["UserManagementError"] is string error)
{
    <div class="alert alert-danger">
        @error
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Correo</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.FullName</td>
                        <td>@user.Email</td>
                        <td>@user.Role</td>

                        <td>
                            @if (user.IsActive)
                            {
                                <span class="badge bg-success">
                                    Activo
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Inactivo
                                </span>
                            }
                        </td>

                        <td>
                            <form
                                asp-action="ToggleStatus"
                                method="post">

                                <input
                                    type="hidden"
                                    name="id"
                                    value="@user.Id" />

                                <button
                                    type="submit"
                                    class="btn btn-sm btn-outline-dark">

                                    @(user.IsActive
                                        ? "Desactivar"
                                        : "Activar")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
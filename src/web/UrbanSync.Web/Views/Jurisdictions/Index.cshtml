@model JurisdictionsViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Jurisdicciones";

    var canManage =
        User.IsInRole("Administrador") ||
        User.IsInRole("SupervisorOperaciones");
}

<div class="mb-4">
    <h1 class="fw-bold mb-1">Jurisdicciones</h1>
    <p class="text-muted mb-0">Divisiones territoriales (provincia, municipio, distrito, sector).</p>
</div>

@if (TempData["JurisdictionsSuccess"] is string success)
{
    <div class="alert alert-success">@success</div>
}

@if (TempData["JurisdictionsError"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

@if (canManage)
{
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <h2 class="h6 fw-bold mb-3">Agregar jurisdicción</h2>

            <form asp-action="Create" method="post" class="row g-2 align-items-end">
                @Html.AntiForgeryToken()

                <div class="col-md-4">
                    <label class="form-label small fw-semibold">Nombre</label>
                    <input type="text" name="name" class="form-control form-control-sm" maxlength="100" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Nivel</label>
                    <input type="text" name="level" class="form-control form-control-sm" maxlength="30" placeholder="Provincia, Municipio..." required />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Jurisdicción padre (opcional)</label>
                    <select name="parentJurisdictionId" class="form-select form-select-sm">
                        <option value="">— Ninguna —</option>
                        @foreach (var opcion in Model.OpcionesPadre)
                        {
                            <option value="@opcion.Id">@opcion.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-sm btn-dark w-100">Agregar</button>
                </div>
            </form>
        </div>
    </div>
}

@if (!Model.DatosDisponibles)
{
    <div class="card border-0 shadow-sm rounded-4 admin-kpi-pending">
        <div class="card-body text-center py-5">
            <i class="bi bi-wifi-off fs-1 text-muted mb-3 d-block"></i>
            <h3 class="fw-bold fs-5 mb-1 text-muted">Sin datos disponibles</h3>
            <p class="text-muted mb-0">La API de UrbanSync no respondió. Recarga la página para reintentar.</p>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Nivel</th>
                        <th>Jurisdicción padre</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var jurisdiccion in Model.Jurisdicciones)
                    {
                        <tr>
                            <td>@jurisdiccion.Name</td>
                            <td>@jurisdiccion.Level</td>
                            <td>@(jurisdiccion.ParentJurisdictionName ?? "—")</td>
                            <td>
                                @if (jurisdiccion.IsActive)
                                {
                                    <span class="badge bg-success">Activa</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactiva</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (Model.Jurisdicciones.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                No hay jurisdicciones registradas.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

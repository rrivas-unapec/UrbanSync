@model ClaimsViewModel
@{
    Layout = "_AdminLayout";
    var total = Model.Reclamaciones.Count;
}
<div class="mb-4">
    <h1 class="fw-bold mb-1">Reclamaciones</h1>
    @if (Model.DatosDisponibles)
    {
        <p class="text-muted mb-0">@total reclamaci@(total == 1 ? "ón" : "ones") registrada@(total == 1 ? "" : "s")</p>
    }
</div>

@if (TempData["ClaimsError"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

@if (!Model.DatosDisponibles)
{
    <div class="card border-0 shadow-sm rounded-4 admin-kpi-pending">
        <div class="card-body text-center py-5">
            <i class="bi bi-wifi-off fs-1 text-muted mb-3 d-block"></i>
            <h3 class="fw-bold fs-5 mb-1 text-muted">Sin datos disponibles</h3>
            <p class="text-muted mb-0">La API de UrbanSync no respondió. Recarga la página para reintentar.</p>
        </div>
    </div>
}
else if (total == 0)
{
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body text-center py-5">
            <i class="bi bi-check-circle fs-1 mb-3 d-block" style="color:#00A676;"></i>
            <h3 class="fw-bold fs-5 mb-1">Sin reclamaciones</h3>
            <p class="text-muted mb-0">No hay reclamaciones registradas por los ciudadanos.</p>
        </div>
    </div>
}
else
{
    <div class="d-flex flex-column gap-3">
        @foreach (var item in Model.Reclamaciones)
        {
            var estilo = EstadoEstilo(item.Status);
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <div class="d-flex align-items-start gap-3 flex-wrap">
                        <div class="admin-kpi-icon flex-shrink-0" style="background-color:@estilo.Bg; color:@estilo.Fg;">
                            <i class="bi bi-chat-left-dots"></i>
                        </div>
                        <div class="flex-grow-1" style="min-width:14rem;">
                            <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                <span class="badge rounded-pill" style="background-color:@estilo.Bg; color:@estilo.Fg;">@item.Status</span>
                                <span class="badge bg-light text-dark">@item.Category</span>
                                <span class="text-muted small">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                            <p class="fw-bold mb-0">@item.Title</p>
                            <p class="text-muted small mb-1">@item.Description</p>
                            <p class="text-muted small mb-0">Ciudadano: @item.CitizenUserName · @item.LocationAddress</p>
                        </div>
                        <div class="flex-shrink-0" style="min-width:12rem;">
                            <form asp-action="UpdateStatus" method="post" class="d-flex gap-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <select name="status" class="form-select form-select-sm">
                                    <option value="Pendiente" selected="@(item.Status == "Pendiente")">Pendiente</option>
                                    <option value="EnRevision" selected="@(item.Status == "EnRevision")">En revisión</option>
                                    <option value="Resuelta" selected="@(item.Status == "Resuelta")">Resuelta</option>
                                    <option value="Rechazada" selected="@(item.Status == "Rechazada")">Rechazada</option>
                                </select>
                                <button type="submit" class="btn btn-sm btn-dark">
                                    Actualizar
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@functions {
    (string Bg, string Fg) EstadoEstilo(string estado) => estado switch
    {
        "Resuelta" => ("rgba(0,166,118,.12)", "#00A676"),
        "Rechazada" => ("rgba(228,87,46,.12)", "#E4572E"),
        "EnRevision" => ("rgba(224,122,0,.12)", "#E07A00"),
        _ => ("rgba(0,87,184,.12)", "#0057B8")
    };
}

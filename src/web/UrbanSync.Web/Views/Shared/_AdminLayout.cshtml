@{
    Layout = null;

    var currentController =
        ViewContext.RouteData.Values["controller"]
            ?.ToString();

    var currentAction =
        ViewContext.RouteData.Values["action"]
            ?.ToString();

    var displayName =
        User.Identity?.Name ?? "Administrador";

    var initials =
        string.Concat(
            displayName
                .Split(
                    ' ',
                    StringSplitOptions.RemoveEmptyEntries)
                .Take(2)
                .Select(
                    part =>
                        char.ToUpper(part[0])));

    if (string.IsNullOrWhiteSpace(initials))
    {
        initials = "A";
    }

    var canViewAudit =
        User.IsInRole("Administrador") ||
        User.IsInRole("SupervisorOperaciones");
}

<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="utf-8" />

    <title>
        UrbanSync · Administración
    </title>

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1" />

    <script>
        (function () {
            if (
                localStorage.getItem(
                    "adminPanel.highContrast"
                ) === "true"
            ) {
                document.documentElement.classList.add(
                    "admin-high-contrast"
                );
            }

            if (
                localStorage.getItem(
                    "adminPanel.largeText"
                ) === "true"
            ) {
                document.documentElement.classList.add(
                    "admin-large-text"
                );
            }
        })();
    </script>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
        rel="stylesheet">

    <link
        href="~/css/admin.css"
        rel="stylesheet"
        asp-append-version="true">

</head>

<body class="admin-body">

    <div class="admin-shell">

        <aside
            class="admin-sidebar"
            id="adminSidebar">

            <div class="admin-sidebar-brand">

                <div class="admin-sidebar-brand-icon">
                    🏙️
                </div>

                <div class="admin-sidebar-brand-text">

                    <p class="admin-sidebar-brand-title">
                        UrbanSync
                    </p>

                    <p class="admin-sidebar-brand-sub">
                        Administración
                    </p>

                </div>

                <button
                    type="button"
                    class="admin-sidebar-toggle"
                    id="adminSidebarToggle"
                    aria-label="Colapsar menú lateral">

                    <i class="bi bi-chevron-left"></i>

                </button>

            </div>

            <nav class="admin-nav">

                <a
                    asp-controller="Dashboard"
                    asp-action="Index"
                    class="admin-nav-link
                    @(currentController == "Dashboard" &&
                      currentAction == "Index"
                        ? "active"
                        : "")">

                    <i class="bi bi-bar-chart-line"></i>

                    <span class="admin-nav-label">
                        Panel principal
                    </span>

                </a>

                <a
                    asp-controller="Dashboard"
                    asp-action="Mapa"
                    class="admin-nav-link
                    @(currentController == "Dashboard" &&
                      currentAction == "Mapa"
                        ? "active"
                        : "")">

                    <i class="bi bi-map"></i>

                    <span class="admin-nav-label">
                        Mapa de la ciudad
                    </span>

                </a>

                <a
                    asp-controller="Dashboard"
                    asp-action="ActivosOrdenes"
                    class="admin-nav-link
                    @(currentController == "Dashboard" &&
                      currentAction == "ActivosOrdenes"
                        ? "active"
                        : "")">

                    <i class="bi bi-list-task"></i>

                    <span class="admin-nav-label">
                        Activos y órdenes
                    </span>

                </a>

                <a
                    asp-controller="Dashboard"
                    asp-action="Rutas"
                    class="admin-nav-link
                    @(currentController == "Dashboard" &&
                      currentAction == "Rutas"
                        ? "active"
                        : "")">

                    <i class="bi bi-signpost-split"></i>

                    <span class="admin-nav-label">
                        Rutas de cuadrillas
                    </span>

                </a>

                <a
                    asp-controller="Dashboard"
                    asp-action="Moderacion"
                    class="admin-nav-link
                    @(currentController == "Dashboard" &&
                      currentAction == "Moderacion"
                        ? "active"
                        : "")">

                    <i class="bi bi-exclamation-circle"></i>

                    <span class="admin-nav-label">
                        Moderación
                    </span>

                </a>

                <a
                    asp-controller="Incidents"
                    asp-action="Index"
                    class="admin-nav-link
                    @(currentController == "Incidents"
                        ? "active"
                        : "")">

                    <i class="bi bi-exclamation-triangle"></i>

                    <span class="admin-nav-label">
                        Incidencias
                    </span>

                </a>

                <a
                    asp-controller="Claims"
                    asp-action="Index"
                    class="admin-nav-link
                    @(currentController == "Claims"
                        ? "active"
                        : "")">

                    <i class="bi bi-chat-left-dots"></i>

                    <span class="admin-nav-label">
                        Reclamaciones
                    </span>

                </a>

                @if (canViewAudit)
                {
                    <a
                        asp-controller="Activity"
                        asp-action="Index"
                        class="admin-nav-link
                        @(currentController == "Activity"
                            ? "active"
                            : "")">

                        <i class="bi bi-clock-history"></i>

                        <span class="admin-nav-label">
                            Auditoría
                        </span>

                    </a>
                }

            </nav>

            <div class="admin-sidebar-footer">

                <div class="admin-sidebar-avatar">
                    @initials
                </div>

                <div class="admin-sidebar-footer-text">

                    <p class="admin-sidebar-footer-name">
                        @displayName
                    </p>

                    <p class="admin-sidebar-footer-role">
                        @(User.IsInRole("Administrador")
                            ? "Administrador"
                            : User.IsInRole("SupervisorOperaciones")
                                ? "Supervisor"
                                : User.IsInRole("AnalistaTecnico")
                                    ? "Analista técnico"
                                    : "Usuario")
                    </p>

                </div>

            </div>

        </aside>

        <div class="admin-main">

            <header class="admin-topbar">

                <div class="admin-search">

                    <i class="bi bi-search"></i>

                    <input
                        type="text"
                        placeholder="Buscar en el panel..."
                        disabled />

                </div>

                <div class="admin-topbar-actions">

                    <button
                        type="button"
                        class="admin-a11y-btn admin-a11y-contrast"
                        id="adminContrastToggle"
                        aria-pressed="false">

                        <i class="bi bi-brightness-high"></i>

                        <span>
                            Alto contraste
                        </span>

                    </button>

                    <button
                        type="button"
                        class="admin-a11y-btn admin-a11y-text"
                        id="adminTextSizeToggle"
                        aria-pressed="false">

                        <i class="bi bi-fonts"></i>

                        <span>
                            Texto grande
                        </span>

                    </button>

                    <button
                        type="button"
                        class="admin-icon-btn"
                        aria-label="Notificaciones — sin notificaciones nuevas">

                        <i class="bi bi-bell"></i>

                    </button>

                    <a
                        asp-controller="Auth"
                        asp-action="ChangePassword"
                        class="admin-icon-btn"
                        aria-label="Cambiar contraseña"
                        title="Cambiar contraseña">

                        <i class="bi bi-key"></i>

                    </a>

                    <form
                        asp-controller="Auth"
                        asp-action="Logout"
                        method="post"
                        class="m-0">

                        @Html.AntiForgeryToken()

                        <button
                            type="submit"
                            class="admin-icon-btn"
                            aria-label="Salir"
                            title="Cerrar sesión">

                            <i class="bi bi-box-arrow-right"></i>

                        </button>

                    </form>

                </div>

            </header>

            <main class="admin-content">
                @RenderBody()
            </main>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script
        src="~/js/admin-layout.js"
        asp-append-version="true">
    </script>

    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>

</html>
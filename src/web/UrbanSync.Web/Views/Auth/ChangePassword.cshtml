@model UrbanSync.Web.ViewModels.ChangePasswordViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1" />

    <title>Cambiar contraseña · UrbanSync</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet" />

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
        rel="stylesheet" />

    <link
        href="~/css/admin.css"
        rel="stylesheet"
        asp-append-version="true" />

    <link
        href="~/css/login.css"
        rel="stylesheet"
        asp-append-version="true" />
</head>

<body class="login-body">
    <main class="login-shell login-shell-register">
        <partial name="_AuthHero" />

        <section class="login-panel">
            <div class="login-panel-inner">
                <header class="login-panel-header">
                    <h1>Cambiar contraseña</h1>

                    <p class="login-panel-sub">
                        Actualiza la contraseña con la que accedes a UrbanSync.
                    </p>
                </header>

                @if (
                    TempData["PasswordChanged"]
                    is string successMessage)
                {
                    <div
                        class="alert alert-success login-alert"
                        role="alert">

                        <i
                            class="bi bi-check-circle-fill"
                            aria-hidden="true">
                        </i>

                        <span>
                            @successMessage
                        </span>
                    </div>
                }

                <form
                    asp-controller="Auth"
                    asp-action="ChangePassword"
                    method="post"
                    class="login-form">

                    @Html.AntiForgeryToken()

                    <div
                        asp-validation-summary="ModelOnly"
                        class="alert alert-danger login-validation-summary"
                        role="alert">
                    </div>

                    <div class="mb-3">
                        <label
                            asp-for="CurrentPassword"
                            class="form-label">
                        </label>

                        <div class="login-password-field">
                            <i
                                class="bi bi-lock login-input-icon"
                                aria-hidden="true">
                            </i>

                            <input
                                asp-for="CurrentPassword"
                                class="form-control"
                                placeholder="Ingresa tu contraseña actual"
                                autocomplete="current-password"
                                autofocus />

                            <button
                                type="button"
                                class="login-password-toggle"
                                aria-label="Mostrar contraseña"
                                aria-pressed="false">

                                <i
                                    class="bi bi-eye"
                                    aria-hidden="true">
                                </i>
                            </button>
                        </div>

                        <span
                            asp-validation-for="CurrentPassword"
                            class="text-danger login-field-error">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label
                            asp-for="NewPassword"
                            class="form-label">
                        </label>

                        <div class="login-password-field">
                            <i
                                class="bi bi-shield-lock login-input-icon"
                                aria-hidden="true">
                            </i>

                            <input
                                asp-for="NewPassword"
                                class="form-control"
                                placeholder="Mínimo 8 caracteres"
                                autocomplete="new-password" />

                            <button
                                type="button"
                                class="login-password-toggle"
                                aria-label="Mostrar contraseña"
                                aria-pressed="false">

                                <i
                                    class="bi bi-eye"
                                    aria-hidden="true">
                                </i>
                            </button>
                        </div>

                        <span
                            asp-validation-for="NewPassword"
                            class="text-danger login-field-error">
                        </span>
                    </div>

                    <div class="mb-4">
                        <label
                            asp-for="ConfirmNewPassword"
                            class="form-label">
                        </label>

                        <div class="login-password-field">
                            <i
                                class="bi bi-shield-check login-input-icon"
                                aria-hidden="true">
                            </i>

                            <input
                                asp-for="ConfirmNewPassword"
                                class="form-control"
                                placeholder="Repite la nueva contraseña"
                                autocomplete="new-password" />

                            <button
                                type="button"
                                class="login-password-toggle"
                                aria-label="Mostrar contraseña"
                                aria-pressed="false">

                                <i
                                    class="bi bi-eye"
                                    aria-hidden="true">
                                </i>
                            </button>
                        </div>

                        <span
                            asp-validation-for="ConfirmNewPassword"
                            class="text-danger login-field-error">
                        </span>
                    </div>

                    <button
                        type="submit"
                        class="btn login-submit w-100">

                        <span>
                            Actualizar contraseña
                        </span>

                        <i
                            class="bi bi-check-lg"
                            aria-hidden="true">
                        </i>
                    </button>

                    <div class="login-register-link">
                        <a
                            asp-controller="Dashboard"
                            asp-action="Index">
                            Volver al panel principal
                        </a>
                    </div>
                </form>
            </div>
        </section>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>

    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script
        src="~/js/login.js"
        asp-append-version="true">
    </script>
</body>
</html>
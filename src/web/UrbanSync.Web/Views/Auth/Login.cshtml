@model UrbanSync.Web.ViewModels.LoginViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1" />

    <title>Iniciar sesión · UrbanSync</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet" />

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
        rel="stylesheet" />

    <link
        href="~/css/admin.css"
        rel="stylesheet"
        asp-append-version="true" />

    <link
        href="~/css/login.css"
        rel="stylesheet"
        asp-append-version="true" />
</head>

<body class="login-body">
    <main class="login-shell">
        <partial name="_AuthHero" />

        <section class="login-panel">
            <div class="login-panel-inner">
                <header class="login-panel-header">
                    <h1>Iniciar sesión</h1>

                    <p class="login-panel-sub">
                        Accede a la plataforma de gestión urbana de UrbanSync.
                    </p>
                </header>

                @if (TempData["RegistrationSuccess"] is string successMessage)
                {
                    <div
                        class="alert alert-success login-alert"
                        role="alert">
                        <i class="bi bi-check-circle-fill"></i>

                        <span>@successMessage</span>
                    </div>
                }

                <form
                    asp-controller="Auth"
                    asp-action="Login"
                    method="post"
                    class="login-form">

                    @Html.AntiForgeryToken()

                    <div
                        asp-validation-summary="ModelOnly"
                        class="alert alert-danger login-validation-summary"
                        role="alert">
                    </div>

                    <div class="mb-3">
                        <label
                            asp-for="Email"
                            class="form-label">
                            Correo electrónico
                        </label>

                        <div class="login-input-field">
                            <i
                                class="bi bi-envelope login-input-icon"
                                aria-hidden="true">
                            </i>

                            <input
                                asp-for="Email"
                                class="form-control"
                                type="email"
                                placeholder="usuario@urbansync.com"
                                autocomplete="username"
                                autofocus />
                        </div>

                        <span
                            asp-validation-for="Email"
                            class="text-danger login-field-error">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label
                            asp-for="Password"
                            class="form-label">
                            Contraseña
                        </label>

                        <div class="login-password-field">
                            <i
                                class="bi bi-lock login-input-icon"
                                aria-hidden="true">
                            </i>

                            <input
                                asp-for="Password"
                                class="form-control"
                                type="password"
                                placeholder="Ingresa tu contraseña"
                                autocomplete="current-password" />

                            <button
                                type="button"
                                class="login-password-toggle"
                                aria-label="Mostrar contraseña"
                                aria-pressed="false">
                                <i
                                    class="bi bi-eye"
                                    aria-hidden="true">
                                </i>
                            </button>
                        </div>

                        <span
                            asp-validation-for="Password"
                            class="text-danger login-field-error">
                        </span>
                    </div>

                    <div class="login-form-options">
                        <div class="form-check">
                            <input
                                asp-for="RememberMe"
                                class="form-check-input" />

                            <label
                                asp-for="RememberMe"
                                class="form-check-label">
                                Mantener sesión iniciada
                            </label>
                        </div>

                    </div>

                    <button
                        type="submit"
                        class="btn login-submit w-100">
                        <span>Iniciar sesión</span>

                        <i
                            class="bi bi-arrow-right"
                            aria-hidden="true">
                        </i>
                    </button>
                </form>

                <div class="login-demo-box">
                    <p class="login-demo-title">
                        <i
                            class="bi bi-key-fill"
                            aria-hidden="true">
                        </i>

                        Credenciales de demostración
                    </p>

                    <p class="login-demo-line">
                        Correo:
                        <code>admin@urbansync.com</code>
                    </p>

                    <p class="login-demo-line">
                        Contraseña:
                        <code>UrbanSync@2026</code>
                    </p>
                </div>

                <div class="login-register-link">
                    <span>¿No tienes una cuenta?</span>

                    <a
                        asp-controller="Auth"
                        asp-action="Register">
                        Crear cuenta ciudadana
                    </a>
                </div>
            </div>
        </section>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>

    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script
        src="~/js/login.js"
        asp-append-version="true">
    </script>
</body>
</html>
@model IReadOnlyList<UrbanSync.Web.ApiClients.Activity.ActivityResponse>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Auditoría";

    int? usuarioId = ViewBag.UsuarioId;
    string? entidad = ViewBag.Entidad;
    string? accion = ViewBag.Accion;
    DateTime? fechaInicio = ViewBag.FechaInicio;
    DateTime? fechaFin = ViewBag.FechaFin;

    var hasFilters =
        usuarioId.HasValue ||
        !string.IsNullOrWhiteSpace(entidad) ||
        !string.IsNullOrWhiteSpace(accion) ||
        fechaInicio.HasValue ||
        fechaFin.HasValue;
}

<section class="audit-page">

    <header class="audit-page-header">

        <div>
            <div class="audit-page-eyebrow">
                <i class="bi bi-shield-check"></i>
                Trazabilidad del sistema
            </div>

            <h1 class="audit-page-title">
                Auditoría de actividades
            </h1>

            <p class="audit-page-subtitle">
                Consulta las acciones registradas en UrbanSync,
                identifica quién realizó cada operación y revisa
                los cambios asociados.
            </p>
        </div>

        <div class="audit-event-counter">

            <div class="audit-event-counter-icon">
                <i class="bi bi-clock-history"></i>
            </div>

            <div>
                <strong>
                    @Model.Count
                </strong>

                <span>
                    evento@(Model.Count == 1 ? "" : "s")
                </span>
            </div>

        </div>

    </header>

    @if (TempData["ActivityError"] is string tempError)
    {
        <div
            class="alert alert-danger audit-alert"
            role="alert">

            <i class="bi bi-exclamation-circle me-2"></i>
            @tempError

        </div>
    }

    @if (ViewBag.Error is string error)
    {
        <div
            class="alert alert-danger audit-alert"
            role="alert">

            <i class="bi bi-exclamation-circle me-2"></i>
            @error

        </div>
    }

    <form
        method="get"
        asp-controller="Activity"
        asp-action="Index"
        class="audit-filter-card">

        <div class="audit-filter-header">

            <div>
                <h2 class="audit-filter-title">
                    <i class="bi bi-funnel"></i>
                    Filtros
                </h2>

                <p class="audit-filter-description">
                    Refina los eventos mostrados en el historial.
                </p>
            </div>

            @if (hasFilters)
            {
                <span class="audit-filter-active">
                    <i class="bi bi-check-circle"></i>
                    Filtros aplicados
                </span>
            }

        </div>

        <div class="audit-filter-grid">

            <div class="audit-filter-field audit-filter-user">

                <label
                    for="usuarioId"
                    class="audit-filter-label">
                    ID de usuario
                </label>

                <div class="audit-input-wrapper">

                    <i class="bi bi-person audit-input-icon"></i>

                    <input
                        id="usuarioId"
                        name="usuarioId"
                        type="number"
                        min="1"
                        class="form-control audit-input"
                        value="@usuarioId"
                        placeholder="Ej. 1" />

                </div>

            </div>

            <div class="audit-filter-field">

                <label
                    for="entidad"
                    class="audit-filter-label">
                    Entidad
                </label>

                <div class="audit-input-wrapper">

                    <i class="bi bi-box audit-input-icon"></i>

                    <input
                        id="entidad"
                        name="entidad"
                        class="form-control audit-input"
                        value="@entidad"
                        placeholder="Ej. Incidencias" />

                </div>

            </div>

            <div class="audit-filter-field">

                <label
                    for="accion"
                    class="audit-filter-label">
                    Acción
                </label>

                <div class="audit-input-wrapper">

                    <i class="bi bi-activity audit-input-icon"></i>

                    <input
                        id="accion"
                        name="accion"
                        class="form-control audit-input"
                        value="@accion"
                        placeholder="Ej. Triage" />

                </div>

            </div>

            <div class="audit-filter-field">

                <label
                    for="fechaInicio"
                    class="audit-filter-label">
                    Desde
                </label>

                <input
                    id="fechaInicio"
                    name="fechaInicio"
                    type="datetime-local"
                    class="form-control audit-input audit-date-input"
                    value="@(fechaInicio?.ToString("yyyy-MM-ddTHH:mm"))" />

            </div>

            <div class="audit-filter-field">

                <label
                    for="fechaFin"
                    class="audit-filter-label">
                    Hasta
                </label>

                <input
                    id="fechaFin"
                    name="fechaFin"
                    type="datetime-local"
                    class="form-control audit-input audit-date-input"
                    value="@(fechaFin?.ToString("yyyy-MM-ddTHH:mm"))" />

            </div>

        </div>

        <div class="audit-filter-actions">

            <button
                type="submit"
                class="btn audit-search-btn">

                <i class="bi bi-search"></i>
                Buscar
            </button>

            <a
                asp-controller="Activity"
                asp-action="Index"
                class="btn audit-clear-btn">

                <i class="bi bi-arrow-counterclockwise"></i>
                Limpiar
            </a>

        </div>

    </form>

    @if (Model.Count == 0)
    {
        <section class="audit-empty-state">

            <div class="audit-empty-icon">
                <i class="bi bi-clock-history"></i>
            </div>

            <h2>
                No hay eventos de auditoría
            </h2>

            @if (hasFilters)
            {
                <p>
                    No encontramos actividades que coincidan
                    con los filtros seleccionados.
                </p>

                <a
                    asp-controller="Activity"
                    asp-action="Index"
                    class="btn audit-search-btn">

                    <i class="bi bi-arrow-counterclockwise"></i>
                    Limpiar filtros
                </a>
            }
            else
            {
                <p>
                    Todavía no existen actividades registradas
                    para mostrar.
                </p>
            }

        </section>
    }
    else
    {
        <section class="audit-table-card">

            <div class="audit-table-header">

                <div>
                    <h2>
                        Historial de actividades
                    </h2>

                    <p>
                        Eventos encontrados según los criterios actuales.
                    </p>
                </div>

                <span class="audit-table-result-count">
                    @Model.Count resultado@(Model.Count == 1 ? "" : "s")
                </span>

            </div>

            <div class="table-responsive">

                <table class="audit-table">

                    <thead>
                        <tr>
                            <th class="audit-col-date">
                                Fecha
                            </th>

                            <th class="audit-col-user">
                                Usuario
                            </th>

                            <th class="audit-col-action">
                                Acción
                            </th>

                            <th class="audit-col-entity">
                                Entidad
                            </th>

                            <th class="audit-col-record">
                                Registro
                            </th>

                            <th class="audit-col-detail">
                                Detalle
                            </th>

                            <th class="audit-col-options text-center">
                                Acciones
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                    @foreach (var activity in Model)
                    {
                        <tr>

                            <td class="audit-date-cell">

                                <div class="audit-date-primary">
                                    @activity.FechaHora.ToString(
                                        "dd/MM/yyyy")
                                </div>

                                <div class="audit-date-secondary">
                                    <i class="bi bi-clock"></i>

                                    @activity.FechaHora.ToString(
                                        "HH:mm")
                                </div>

                            </td>

                            <td>

                                <div class="audit-user">

                                    <div class="audit-user-avatar">
                                        @GetInitial(
                                            activity.NombreUsuario)
                                    </div>

                                    <div class="audit-user-info">

                                        <strong>
                                            @(activity.NombreUsuario
                                                ?? "Sistema")
                                        </strong>

                                        @if (activity.UsuarioId.HasValue)
                                        {
                                            <span>
                                                ID @activity.UsuarioId
                                            </span>
                                        }
                                        else
                                        {
                                            <span>
                                                Evento del sistema
                                            </span>
                                        }

                                    </div>

                                </div>

                            </td>

                            <td>

                                <span
                                    class="audit-action-badge
                                           @GetActionClass(
                                               activity.Accion)">

                                    <i class="@GetActionIcon(
                                        activity.Accion)">
                                    </i>

                                    @activity.Accion

                                </span>

                            </td>

                            <td>

                                <span class="audit-entity">

                                    <i class="@GetEntityIcon(
                                        activity.Entidad)">
                                    </i>

                                    @(activity.Entidad ?? "—")

                                </span>

                            </td>

                            <td>

                                @if (activity.EntidadId.HasValue)
                                {
                                    <span class="audit-record-id">
                                        #@activity.EntidadId
                                    </span>
                                }
                                else
                                {
                                    <span class="audit-muted">
                                        —
                                    </span>
                                }

                            </td>

                            <td>

                                @if (
                                    string.IsNullOrWhiteSpace(
                                        activity.Detalle))
                                {
                                    <span class="audit-muted">
                                        Sin detalle
                                    </span>
                                }
                                else
                                {
                                    <div
                                        class="audit-detail"
                                        title="@activity.Detalle">

                                        @activity.Detalle

                                    </div>
                                }

                            </td>

                            <td class="text-center">

                                <a
                                    asp-controller="Activity"
                                    asp-action="Details"
                                    asp-route-id="@activity.Id"
                                    class="audit-view-btn"
                                    title="Ver detalle del evento">

                                    <i class="bi bi-eye"></i>

                                    <span>
                                        Ver
                                    </span>

                                </a>

                            </td>

                        </tr>
                    }

                    </tbody>

                </table>

            </div>

        </section>
    }

</section>

@functions {

    string GetInitial(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "S";
        }

        return value
            .Trim()
            .Substring(0, 1)
            .ToUpperInvariant();
    }

    string GetActionClass(string? action)
    {
        var normalized =
            action?.Trim().ToLowerInvariant() ?? string.Empty;

        if (normalized.Contains("triage"))
        {
            return "audit-action-triage";
        }

        if (
            normalized.Contains("reporte") ||
            normalized.Contains("crear"))
        {
            return "audit-action-create";
        }

        if (
            normalized.Contains("actualizar") ||
            normalized.Contains("cambio"))
        {
            return "audit-action-update";
        }

        if (
            normalized.Contains("asignar") ||
            normalized.Contains("asignación"))
        {
            return "audit-action-assign";
        }

        if (
            normalized.Contains("eliminar") ||
            normalized.Contains("rechazar"))
        {
            return "audit-action-danger";
        }

        return "audit-action-default";
    }

    string GetActionIcon(string? action)
    {
        var normalized =
            action?.Trim().ToLowerInvariant() ?? string.Empty;

        if (normalized.Contains("triage"))
        {
            return "bi bi-clipboard2-pulse";
        }

        if (
            normalized.Contains("reporte") ||
            normalized.Contains("crear"))
        {
            return "bi bi-plus-circle";
        }

        if (
            normalized.Contains("actualizar") ||
            normalized.Contains("cambio"))
        {
            return "bi bi-arrow-repeat";
        }

        if (
            normalized.Contains("asignar") ||
            normalized.Contains("asignación"))
        {
            return "bi bi-person-check";
        }

        if (
            normalized.Contains("eliminar") ||
            normalized.Contains("rechazar"))
        {
            return "bi bi-exclamation-triangle";
        }

        return "bi bi-activity";
    }

    string GetEntityIcon(string? entity)
    {
        var normalized =
            entity?.Trim().ToLowerInvariant() ?? string.Empty;

        if (normalized.Contains("incidencia"))
        {
            return "bi bi-exclamation-triangle";
        }

        if (normalized.Contains("reporte"))
        {
            return "bi bi-file-earmark-text";
        }

        if (
            normalized.Contains("trabajo") ||
            normalized.Contains("orden"))
        {
            return "bi bi-tools";
        }

        if (normalized.Contains("usuario"))
        {
            return "bi bi-person";
        }

        return "bi bi-box";
    }
}
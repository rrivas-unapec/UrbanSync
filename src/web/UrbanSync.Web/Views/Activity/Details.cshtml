@model UrbanSync.Web.ApiClients.Activity.ActivityResponse

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Detalle de auditoría";
}

<div class="mb-4">

    <a
        asp-action="Index"
        class="text-decoration-none small">

        <i class="bi bi-arrow-left me-1"></i>
        Volver a auditoría
    </a>

    <h1 class="fw-bold mt-2 mb-1">
        Evento #@Model.Id
    </h1>

    <p class="text-muted mb-0">
        Detalle del registro de trazabilidad.
    </p>
</div>

<div class="row g-4">

    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">

            <div class="card-body p-4">

                <div class="d-flex justify-content-between
                            align-items-start gap-3 flex-wrap mb-4">

                    <div>
                        <span class="badge text-bg-primary mb-2">
                            @Model.Accion
                        </span>

                        <h2 class="h5 fw-bold mb-0">
                            @(Model.Entidad ?? "Actividad del sistema")
                        </h2>
                    </div>

                    <span class="text-muted">
                        @Model.FechaHora.ToString(
                            "dd/MM/yyyy HH:mm:ss")
                    </span>
                </div>

                <div class="mb-4">

                    <span class="text-muted small d-block mb-1">
                        Detalle
                    </span>

                    <div class="p-3 bg-light rounded-3">
                        @(string.IsNullOrWhiteSpace(Model.Detalle)
                            ? "Sin detalle."
                            : Model.Detalle)
                    </div>

                </div>

                <div class="row g-3">

                    <div class="col-md-6">
                        <span class="text-muted small d-block">
                            Usuario
                        </span>

                        <strong>
                            @(Model.NombreUsuario ?? "Sistema")
                        </strong>
                    </div>

                    <div class="col-md-6">
                        <span class="text-muted small d-block">
                            Usuario ID
                        </span>

                        <strong>
                            @(Model.UsuarioId?.ToString() ?? "—")
                        </strong>
                    </div>

                    <div class="col-md-6">
                        <span class="text-muted small d-block">
                            Entidad
                        </span>

                        <strong>
                            @(Model.Entidad ?? "—")
                        </strong>
                    </div>

                    <div class="col-md-6">
                        <span class="text-muted small d-block">
                            Entidad ID
                        </span>

                        <strong>
                            @(Model.EntidadId?.ToString() ?? "—")
                        </strong>
                    </div>

                    <div class="col-md-6">
                        <span class="text-muted small d-block">
                            IP de origen
                        </span>

                        <strong>
                            @(Model.IpOrigen ?? "—")
                        </strong>
                    </div>

                </div>

            </div>
        </div>
    </div>

    @if (
        string.Equals(
            Model.Entidad,
            "Incidencias",
            StringComparison.OrdinalIgnoreCase)
        && Model.EntidadId.HasValue)
    {
        <div class="col-lg-4">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4">

                    <h2 class="h5 fw-bold">
                        Incidencia relacionada
                    </h2>

                    <p class="text-muted">
                        Este evento corresponde a la incidencia
                        #@Model.EntidadId.
                    </p>

                    <a
                        asp-controller="Incidents"
                        asp-action="Details"
                        asp-route-id="@Model.EntidadId"
                        class="btn btn-outline-primary w-100">

                        Ver incidencia
                    </a>

                </div>
            </div>

        </div>
    }

</div>
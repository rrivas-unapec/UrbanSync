@model AssetDetailsViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Detalle de activo";
    var activo = Model.Asset;
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none small">
        <i class="bi bi-arrow-left me-1"></i>
        Volver a activos
    </a>

    <h1 class="fw-bold mt-2 mb-1">@activo.Name</h1>

    <div class="d-flex gap-2 flex-wrap">
        <span class="badge text-bg-light border font-monospace">@activo.Code</span>
        <span class="badge text-bg-primary">@activo.Status</span>
        <span class="badge text-bg-light border">@activo.Type</span>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <h2 class="h6 fw-bold mb-3">Información</h2>

                <span class="text-muted small d-block">Jurisdicción</span>
                <strong class="d-block mb-3">@activo.JurisdictionName</strong>

                <span class="text-muted small d-block">Fecha de instalación</span>
                <strong class="d-block mb-3">@(activo.InstallationDate?.ToString("dd/MM/yyyy") ?? "—")</strong>

                <span class="text-muted small d-block">Estado del registro</span>
                @if (activo.IsActive)
                {
                    <span class="badge bg-success">Activo</span>
                }
                else
                {
                    <span class="badge bg-danger">Inactivo</span>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <h2 class="h6 fw-bold mb-3">Historial de incidencias</h2>

                @if (!Model.HistorialDisponible)
                {
                    <p class="text-muted small mb-0">
                        No se pudo consultar el historial de este activo.
                    </p>
                }
                else if (Model.Historial.Count == 0)
                {
                    <p class="text-muted small mb-0">
                        Este activo no tiene incidencias reportadas.
                    </p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Caso</th>
                                    <th>Tipo</th>
                                    <th>Descripción</th>
                                    <th>Estado</th>
                                    <th>Fecha</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var evento in Model.Historial)
                                {
                                    <tr>
                                        <td class="font-monospace small">@evento.CaseCode</td>
                                        <td>@evento.IncidentType</td>
                                        <td>@evento.Description</td>
                                        <td><span class="badge text-bg-light border">@evento.Status</span></td>
                                        <td>@evento.ReportDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

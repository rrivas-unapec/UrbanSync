@model AssetsViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Activos urbanos";

    var canManage =
        User.IsInRole("Administrador") ||
        User.IsInRole("SupervisorOperaciones");
}

<div class="mb-4">
    <h1 class="fw-bold mb-1">Activos urbanos</h1>
    <p class="text-muted mb-0">Infraestructura de la ciudad (postes, semáforos, tuberías, etc.) que puede recibir incidencias.</p>
</div>

@if (TempData["AssetsSuccess"] is string success)
{
    <div class="alert alert-success">@success</div>
}

@if (TempData["AssetsError"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

@if (canManage)
{
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <h2 class="h6 fw-bold mb-3">Agregar activo</h2>

            @if (Model.OpcionesJurisdiccion.Count == 0)
            {
                <p class="text-muted small mb-0">
                    Primero debes registrar al menos una jurisdicción.
                </p>
            }
            else
            {
                <form asp-action="Create" method="post" class="row g-2 align-items-end">
                    @Html.AntiForgeryToken()

                    <div class="col-md-2">
                        <label class="form-label small fw-semibold">Código</label>
                        <input type="text" name="code" class="form-control form-control-sm" maxlength="50" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">Nombre</label>
                        <input type="text" name="name" class="form-control form-control-sm" maxlength="100" required />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-semibold">Tipo</label>
                        <input type="text" name="type" class="form-control form-control-sm" maxlength="50" placeholder="Poste, Semáforo..." required />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-semibold">Estado</label>
                        <input type="text" name="status" class="form-control form-control-sm" maxlength="30" placeholder="Operativo" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-semibold">Jurisdicción</label>
                        <select name="jurisdictionId" class="form-select form-select-sm" required>
                            @foreach (var opcion in Model.OpcionesJurisdiccion)
                            {
                                <option value="@opcion.Id">@opcion.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-1">
                        <button type="submit" class="btn btn-sm btn-dark w-100">Agregar</button>
                    </div>
                </form>
            }
        </div>
    </div>
}

@if (!Model.DatosDisponibles)
{
    <div class="card border-0 shadow-sm rounded-4 admin-kpi-pending">
        <div class="card-body text-center py-5">
            <i class="bi bi-wifi-off fs-1 text-muted mb-3 d-block"></i>
            <h3 class="fw-bold fs-5 mb-1 text-muted">Sin datos disponibles</h3>
            <p class="text-muted mb-0">La API de UrbanSync no respondió. Recarga la página para reintentar.</p>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Tipo</th>
                        <th>Estado</th>
                        <th>Jurisdicción</th>
                        <th>Instalación</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var activo in Model.Activos)
                    {
                        <tr>
                            <td class="font-monospace small">@activo.Code</td>
                            <td>@activo.Name</td>
                            <td>@activo.Type</td>
                            <td><span class="badge text-bg-light border">@activo.Status</span></td>
                            <td>@activo.JurisdictionName</td>
                            <td>@(activo.InstallationDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@activo.Id" class="btn btn-sm btn-outline-dark">
                                    Ver historial
                                </a>
                            </td>
                        </tr>
                    }
                    @if (Model.Activos.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                No hay activos urbanos registrados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

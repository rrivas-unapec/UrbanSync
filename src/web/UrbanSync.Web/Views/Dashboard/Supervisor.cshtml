@model PanelPrincipalViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Panel de Supervisor";
}

<div class="mb-4">
    <span class="badge bg-primary mb-2">Supervisor de Operaciones</span>
    <h1 class="fw-bold mb-1">Panel de operaciones</h1>
    <p class="text-muted mb-0">Vista amplia de incidencias, trabajos, reclamaciones y catálogos.</p>
</div>

@if (Model.DatosDisponibles)
{
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <span class="text-muted small d-block">Total incidencias</span>
                    <p class="fs-3 fw-bold mb-0">@Model.TotalReportes.ToString("N0")</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <span class="text-muted small d-block">Órdenes activas</span>
                    <p class="fs-3 fw-bold mb-0">@Model.OrdenesActivas.ToString("N0")</p>
                </div>
            </div>
        </div>
    </div>
}

<div class="row g-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4">
                <i class="bi bi-exclamation-circle fs-2 text-primary mb-3 d-block"></i>
                <h5 class="fw-bold">Cola de triage</h5>
                <p class="text-muted">Revisa y decide sobre incidencias registradas.</p>
                <a asp-controller="Dashboard" asp-action="Moderacion" class="btn btn-outline-dark">
                    Ir a la cola
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4">
                <i class="bi bi-clipboard-check fs-2 text-primary mb-3 d-block"></i>
                <h5 class="fw-bold">Órdenes de trabajo</h5>
                <p class="text-muted">Crea y da seguimiento a los trabajos asignados a técnicos.</p>
                <a asp-controller="Dashboard" asp-action="ActivosOrdenes" class="btn btn-outline-dark">
                    Ver trabajos
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4">
                <i class="bi bi-people fs-2 text-primary mb-3 d-block"></i>
                <h5 class="fw-bold">Rutas y cuadrillas</h5>
                <p class="text-muted">Consulta la carga de trabajo por técnico.</p>
                <a asp-controller="Dashboard" asp-action="Rutas" class="btn btn-outline-dark">
                    Ver rutas
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4">
                <i class="bi bi-map fs-2 text-primary mb-3 d-block"></i>
                <h5 class="fw-bold">Mapa</h5>
                <p class="text-muted">Ubicación geográfica de las incidencias.</p>
                <a asp-controller="Dashboard" asp-action="Mapa" class="btn btn-outline-dark">
                    Ver mapa
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4">
                <i class="bi bi-chat-left-dots fs-2 text-primary mb-3 d-block"></i>
                <h5 class="fw-bold">Reclamaciones</h5>
                <p class="text-muted">Gestiona reclamaciones de los ciudadanos.</p>
                <a asp-controller="Claims" asp-action="Index" class="btn btn-outline-dark">
                    Ver reclamaciones
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4">
                <i class="bi bi-signpost-split fs-2 text-primary mb-3 d-block"></i>
                <h5 class="fw-bold">Activos urbanos</h5>
                <p class="text-muted">Consulta y registra infraestructura de la ciudad.</p>
                <a asp-controller="Assets" asp-action="Index" class="btn btn-outline-dark">
                    Ver activos
                </a>
            </div>
        </div>
    </div>
</div>

@{
    ViewData["Title"] = "Panel de Ciudadano";
}

<div class="mb-4">
    <span class="badge bg-success mb-2">Ciudadano</span>
    <h1 class="fw-bold mb-1">Panel de participación ciudadana</h1>
    <p class="text-muted mb-0">Reporta problemas urbanos y da seguimiento a tus reportes y reclamaciones.</p>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4">
                <i class="bi bi-exclamation-triangle fs-2 text-primary mb-3 d-block"></i>
                <h5 class="fw-bold">Mis incidencias</h5>
                <p class="text-muted">Consulta el estado de los problemas urbanos que has reportado.</p>
                <a asp-controller="Incidents" asp-action="Index" class="btn btn-outline-dark">
                    Ver mis incidencias
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4">
                <i class="bi bi-plus-circle fs-2 text-primary mb-3 d-block"></i>
                <h5 class="fw-bold">Reportar incidencia</h5>
                <p class="text-muted">¿Encontraste un problema urbano? Repórtalo aquí.</p>
                <a asp-controller="Incidents" asp-action="Create" class="btn btn-primary">
                    Reportar incidencia
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4">
                <i class="bi bi-chat-left-dots fs-2 text-primary mb-3 d-block"></i>
                <h5 class="fw-bold">Mis reclamaciones</h5>
                <p class="text-muted">Consulta el estado de tus reclamaciones.</p>
                <a asp-controller="MyClaims" asp-action="Index" class="btn btn-outline-dark">
                    Ver mis reclamaciones
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4">
                <i class="bi bi-file-earmark-plus fs-2 text-primary mb-3 d-block"></i>
                <h5 class="fw-bold">Crear reclamación</h5>
                <p class="text-muted">Registra una reclamación nueva.</p>
                <a asp-controller="MyClaims" asp-action="Create" class="btn btn-outline-dark">
                    Crear reclamación
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4">
                <i class="bi bi-person-circle fs-2 text-primary mb-3 d-block"></i>
                <h5 class="fw-bold">Mi perfil</h5>
                <p class="text-muted">Cambia tu contraseña de acceso.</p>
                <a asp-controller="Auth" asp-action="ChangePassword" class="btn btn-outline-dark">
                    Cambiar contraseña
                </a>
            </div>
        </div>
    </div>
</div>

@model DepartmentsViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Departamentos";
}

<div class="mb-4">
    <h1 class="fw-bold mb-1">Departamentos</h1>
    <p class="text-muted mb-0">Departamentos internos para el panel de operaciones entre departamentos.</p>
</div>

@if (TempData["DepartmentsSuccess"] is string success)
{
    <div class="alert alert-success">@success</div>
}

@if (TempData["DepartmentsError"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-4">
        <h2 class="h6 fw-bold mb-3">Agregar departamento</h2>

        <form asp-action="Create" method="post" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()

            <div class="col-md-6">
                <label class="form-label small fw-semibold">Nombre</label>
                <input type="text" name="name" class="form-control form-control-sm" maxlength="100" required />
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Jurisdicción (opcional)</label>
                <select name="jurisdictionId" class="form-select form-select-sm">
                    <option value="">— Ninguna —</option>
                    @foreach (var opcion in Model.OpcionesJurisdiccion)
                    {
                        <option value="@opcion.Id">@opcion.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-sm btn-dark w-100">Agregar</button>
            </div>
        </form>
    </div>
</div>

@if (!Model.DatosDisponibles)
{
    <div class="card border-0 shadow-sm rounded-4 admin-kpi-pending">
        <div class="card-body text-center py-5">
            <i class="bi bi-wifi-off fs-1 text-muted mb-3 d-block"></i>
            <h3 class="fw-bold fs-5 mb-1 text-muted">Sin datos disponibles</h3>
            <p class="text-muted mb-0">La API de UrbanSync no respondió. Recarga la página para reintentar.</p>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Jurisdicción</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var departamento in Model.Departamentos)
                    {
                        <tr>
                            <td>@departamento.Name</td>
                            <td>@(departamento.JurisdictionName ?? "—")</td>
                            <td>
                                @if (departamento.IsActive)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactivo</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (Model.Departamentos.Count == 0)
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-4">
                                No hay departamentos registrados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
